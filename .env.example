# LLM Legal Council Configuration
# ================================
# This system has NO hardcoded model defaults.
# You MUST configure your council seats below.

# ============================================
# REQUIRED: OpenRouter API
# ============================================
OPENROUTER_API_KEY=your_api_key_here

# ============================================
# REQUIRED: Council Seats (minimum 2)
# ============================================
# Model identifiers must match OpenRouter's naming convention
# Example models:
#   anthropic/claude-sonnet-4  (Claude Sonnet 4)
#   openai/gpt-4o              (GPT-4o)
#   google/gemini-pro-1.5      (Gemini Pro 1.5)
#   x-ai/grok-2                (Grok 2)

COUNCIL_MODEL_1=anthropic/claude-sonnet-4
COUNCIL_MODEL_2=openai/gpt-4o
COUNCIL_MODEL_3=google/gemini-pro-1.5
# COUNCIL_MODEL_4=x-ai/grok-2
# COUNCIL_MODEL_5=

# ============================================
# OPTIONAL: Chairman Configuration
# ============================================
# By default, the highest-ranked analyst from Stage 2 becomes chairman.
# Set this to force a specific model as chairman.
# CHAIRMAN_MODEL=anthropic/claude-sonnet-4

# ============================================
# TOOL API KEYS
# ============================================

# RAG Worker (Cloudflare) - Search project files
# Deploy the legal-knowledge-worker first, then set these
LEGAL_KNOWLEDGE_WORKER_URL=https://legal-knowledge-worker.YOUR_SUBDOMAIN.workers.dev
LEGAL_KNOWLEDGE_WORKER_TOKEN=your_worker_api_token

# CourtListener - Case law research
# Get API key at: https://www.courtlistener.com/help/api/
COURT_LISTENER_API_KEY=your_courtlistener_api_key

# Perplexity - Web search
# Get API key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key

# ============================================
# OPTIONAL: Runtime Configuration
# ============================================

# Default jurisdiction for legal analysis
DEFAULT_JURISDICTION=NY

# Concurrency limit for parallel API calls (default: 3)
# Increase for faster execution with reliable endpoints
# Decrease if experiencing rate limiting (429 errors)
COUNCIL_CONCURRENCY_LIMIT=3

# Models that don't support JSON schema mode (comma-separated)
# These will use text mode with JSON extraction fallback
# Example: COUNCIL_JSON_FALLBACK_MODELS=anthropic/claude-2,cohere/command
# COUNCIL_JSON_FALLBACK_MODELS=

# ============================================
# OPTIONAL: NotebookLM Podcast Generation
# ============================================
# Generate AI podcast summaries of deliberations using Google Cloud's
# NotebookLM Enterprise Podcast API.
#
# See: https://cloud.google.com/agentspace/notebooklm-enterprise/docs/podcast-api

# REQUIRED for podcast generation: Google Cloud Project ID
# GOOGLE_CLOUD_PROJECT_ID=your_project_id

# AUTHENTICATION (choose one method):
#
# Option 1: Service Account (recommended for production)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
#
# Option 2: Access Token (for testing)
# NOTEBOOKLM_ACCESS_TOKEN=your_access_token
#
# Option 3: gcloud CLI (for development)
# Run: gcloud auth login && gcloud auth application-default login
# No environment variable needed - will use gcloud automatically

# OPTIONAL: Podcast Configuration

# API region: us, eu, or global (default: global)
# NOTEBOOKLM_REGION=global

# Default podcast length: SHORT (4-5 min) or STANDARD (~10 min)
# NOTEBOOKLM_DEFAULT_LENGTH=STANDARD

# Default language code (BCP47 format)
# NOTEBOOKLM_DEFAULT_LANGUAGE=en-US
